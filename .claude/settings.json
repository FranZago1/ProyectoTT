{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 900
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m carrusel:*)",
      "Bash(.venv/bin/python scripts/:*)",
      "Bash(.venv/bin/python trabajo/:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(bash scripts/instalar.sh)",
      "Read(./entrada/**)",
      "Read(./trabajo/**)",
      "Read(./salida/**)",
      "Read(./listos/**)",
      "Edit(./trabajo/**)",
      "Write(./trabajo/**)"
    ]
  }
}
